{
  "expo": {
    "name": "Finotary",
    "slug": "Finova",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#222222"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abhiramkasturi19.Finotary",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.abhiramkasturi19.Finotary",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/FUNGIS/fonts/OpenType-TT/FUNGIS Regular.ttf",
            "./assets/FUNGIS/fonts/OpenType-TT/FUNGIS Bold.ttf",
            "./assets/FUNGIS/fonts/OpenType-TT/FUNGIS Heavy.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4731b222-486b-4391-92ec-f3282b723762"
      }
    },
    "owner": "abhiramkasturi-19"
  }
}
